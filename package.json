{
  "name": "joris-wtf",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test",
    "test:unit": "vitest run",
    "generate:placeholders": "node scripts/generate-placeholders.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.2",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4",
    "svelte-check": "^4.7.6",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
