# Public identifiers. Studio falls back to these in env.ts if unset.
SANITY_STUDIO_PROJECT_ID=elkf1eqd
SANITY_STUDIO_DATASET=production

# Required for `npm run seed`. Editor token from
# https://www.sanity.io/manage/project/elkf1eqd/api#tokens
# Copy this file to studio/.env and fill in the token. Never commit .env.
SANITY_API_WRITE_TOKEN=
